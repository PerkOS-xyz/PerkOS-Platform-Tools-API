# PerkOS Platform Tools API — copy to .env and fill in. Never commit .env.

# ---- Server ----
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# ---- Firebase Admin SDK ----
# Same Firebase project as the miniapp. Grab from the service account
# JSON download in Firebase Console > Project Settings > Service accounts.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Single-line value with `\n` escaped — env files don't support newlines.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- JWT shared with the perkos-a2a-bridge ----
# Generate with: openssl rand -hex 32
# Rotate every 90 days per SECRETS.md.
JWT_SHARED_SECRET=
JWT_MAX_AGE_SECONDS=60

# ---- Rate limit (per wallet, per minute) ----
RATE_LIMIT_READ_PER_MIN=60
RATE_LIMIT_ACTION_PER_MIN=10

# ---- Audit ----
AUDIT_ENABLED=true
